# Copy to .env and fill in. NEVER commit .env. Generate keys with the setup scripts (they use secure random values).

APP_ENV=development
LOG_LEVEL=INFO

# Local development database (docker compose overrides this host to `db`).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/gitpulse
POSTGRES_PASSWORD=change-me-postgres

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
RATE_LIMIT_PER_MINUTE=240

# API keys (comma-separated allowed). Roles: viewer < analyst < admin.
API_KEYS_VIEWER=change-me-viewer-key
API_KEYS_ANALYST=change-me-analyst-key
API_KEYS_ADMIN=change-me-admin-key

# GitHub. Optional but strongly recommended: raises the REST rate limit from 60/h to 5000/h.
# Use a fine-grained token with read-only "Metadata" and "Contents" permissions on public repos.
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com
ALLOW_PRIVATE_REPOS=false

# Pipeline
# Seeded once on API start. Use repo:owner/name (also user:login or org:login).
DEFAULT_TARGETS=repo:octocat/Hello-World,repo:pallets/click
PIPELINE_SCHEDULE_MINUTES=0
SYNC_LOOKBACK_DAYS=90

# Optional OpenAI-compatible LLM narration. Leave LLM_PROVIDER=none to use the rule-based assistant only.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
