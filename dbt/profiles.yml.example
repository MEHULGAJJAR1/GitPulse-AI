# Copy to ~/.dbt/profiles.yml (or set DBT_PROFILES_DIR to this folder) and fill from env.
gitpulse:
  target: dev
  outputs:
    dev:
      type: postgres
      host: "{{ env_var('PGHOST', 'localhost') }}"
      port: "{{ env_var('PGPORT', '5432') | as_number }}"
      user: "{{ env_var('PGUSER', 'postgres') }}"
      password: "{{ env_var('PGPASSWORD', 'postgres') }}"
      dbname: "{{ env_var('PGDATABASE', 'gitpulse') }}"
      schema: analytics
      threads: 4
